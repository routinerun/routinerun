{
  "name": "@routinerun/form",
  "version": "0.1.0",
  "description": "Check and upgrade routines written for Routine Run, in form 1 or form 2.",
  "keywords": [
    "routine-run",
    "routines",
    "checklist",
    "json-schema"
  ],
  "license": "MIT",
  "homepage": "https://routinerun.com/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/routinerun/routinerun.git",
    "directory": "packages/form"
  },
  "bugs": "https://github.com/routinerun/routinerun/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./schema/v1": "./schema/written-routine.v1.schema.json",
    "./schema/v2": "./schema/written-routine.v2.schema.json"
  },
  "bin": {
    "routinerun": "./bin/routinerun.js"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "starters",
    "README.md"
  ],
  "engines": {
