{
  "openapi": "3.0.3",
  "info": {
    "title": "Routine Run connections",
    "version": "1",
    "description": "An address made in the Routine Run app (Settings \u203a Connections) starts or moves a routine on the one iPhone that made it. https://routinerun.com/developers"
  },
  "servers": [
    {
      "url": "https://api.routinerun.com/v1/in/{connection}",
      "variables": {
        "connection": {
          "default": "00000000-0000-0000-0000-000000000000",
          "description": "The connection's id, from its address."
        }
      }
    }
  ],
  "security": [
    {
      "secret": []
    }
  ],
  "paths": {
    "/events": {
      "post": {
        "summary": "Hand over an event",
        "description": "What Handle Event does in Shortcuts: the person's Sources decide which routine starts. A generic webhook's own words are read too: with no title, the first line of body, message, msg, text or content is the title and the rest the body. A body that is not JSON, sent without a JSON content type, is those words. Up to 64 KB is read; what reaches the phone is cut to fit a push.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "What happened. If left out, the first line of the words below."
                  },
                  "body": {
                    "type": "string",
                    "description": "More of it."
                  },
                  "message": {
                    "type": "string",
                    "description": "Read as body when body is not given."
                  },
                  "msg": {
                    "type": "string",
                    "description": "Read as body when body is not given."
                  },
                  "text": {
                    "type": "string",
                    "description": "Read as body when body is not given."
                  },
                  "content": {
                    "type": "string",
                    "description": "Read as body when body is not given."
                  },
                  "source": {
                    "type": "string",
                    "description": "Who sent it. The connection's name if left out."
                  },
                  "externalId": {
                    "type": "string",
                    "description": "The sender's own id; a duplicate is recognised by it."
                  },
                  "routine": {
                    "type": "string",
                    "description": "A routine to start, by name or id, instead of letting Sources decide."
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "text/plain": {
              "schema": {
                "type": "string",
                "description": "The words: the first line is the title."
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Handed to Apple for the phone. Not yet done.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/runs": {
      "post": {
        "summary": "Start a routine",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "routine"
                ],
                "properties": {
                  "routine": {
                    "type": "string",
                    "description": "The routine's name, in any case, or its id."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Handed to Apple for the phone. Not yet done.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "get": {
        "summary": "Runs going now",
        "operationId": "listRuns",
        "responses": {
          "200": {
            "description": "The phone's answer"
          },
          "504": {
            "description": "The phone did not answer in time"
          }
        }
      }
    },
    "/runs/{run}/next": {
      "post": {
        "summary": "Move a run on",
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The run's id."
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expectsStep": {
                    "type": "string",
                    "description": "The step id the run should be on; refused if it has moved."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Handed to Apple for the phone. Not yet done.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
