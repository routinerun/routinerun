    "/alertmanager": {
      "post": {
        "summary": "Take an Alertmanager notification",
        "description": "Alertmanager's webhook (version 4), as sent, with the secret in http_config's authorization. One firing group becomes one event: the title is [FIRING:n] and the alert name, the body the summary and description annotations, the event's id the group's labels, and a routine annotation or label names the routine to start. A notification of a cleared group is answered 202 with sent false and not passed on. Up to 64 KB.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status",
                  "alerts"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Handed to Apple for the phone, or, for a cleared group, heard and not sent (sent: false).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/grafana": {
      "post": {
        "summary": "Take a Grafana alert notification",
        "description": "Grafana's webhook contact point, as sent, with the secret as its Authorization credentials. Read as Alertmanager's, with Grafana's own title and, where there are no annotations, its message.",
