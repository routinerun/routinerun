    "/v2/enqueue": {
      "post": {
        "summary": "Take an Events API v2 event",
        "description": "PagerDuty's Events API v2 format, for any tool that lets you change its address: Alertmanager, Grafana, Uptime Kuma, Zabbix. The secret goes in routing_key, or in an Authorization header. A trigger becomes an event: payload.summary is the title, custom_details the body, dedup_key the event's id, and custom_details.routine names the routine to start. acknowledge and resolve are answered and not passed on.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "event_action"
                ],
                "properties": {
                  "routing_key": {
                    "type": "string",
                    "description": "The connection's secret, rr_\u2026"
                  },
                  "event_action": {
                    "type": "string",
                    "enum": [
                      "trigger",
                      "acknowledge",
                      "resolve"
                    ]
                  },
                  "dedup_key": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object",
                    "properties": {
                      "summary": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string"
                      },
                      "severity": {
                        "type": "string"
                      },
                      "component": {
                        "type": "string"
                      },
                      "group": {
                        "type": "string"
                      },
                      "class": {
                        "type": "string"
                      },
                      "custom_details": {}
                    }
                  },
                  "client": {
                    "type": "string"
                  },
                  "client_url": {
                    "type": "string"
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Answered as the Events API answers; command is there when something was sent to the phone.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "dedup_key": {
                      "type": "string"
                    },
                    "command": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "secret": []
          },
          {}
        ]
      }
    },
